{
  "name": "dsh-study-with-cyrene",
  "version": "0.2.0",
  "description": "StudyWithCyrene — a Cyrene-voiced study supervisor for DeepSeek Harness: random screenshots, local OCR/rules, optional vision, full-screen reminders, stats and study companionship.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.10",
    "react": "^18.2.0 || ^19.3.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "license": "MIT"
}
